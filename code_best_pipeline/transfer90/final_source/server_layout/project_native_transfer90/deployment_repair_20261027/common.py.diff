 HERE = Path(__file__).resolve().parent
 
 
+def relocate_deployment_paths(value):
+    """Map historical absolute paths at read time; never rewrite run evidence.
+
+    Enabled only inside this relocated VM4 deployment. Hashes continue to cover
+    original on-disk bytes, including historical configs and resume identities.
+    """
+    if not str(HERE).startswith('/var/lib/wmq/logs/'):
+        return value
+    if isinstance(value, str):
+        prefix = '/root/logs'
+        if value == prefix or value.startswith(prefix + '/'):
+            return '/var/lib/wmq/logs' + value[len(prefix):]
+        return value
+    if isinstance(value, list):
+        return [relocate_deployment_paths(v) for v in value]
+    if isinstance(value, dict):
+        return {k: relocate_deployment_paths(v) for k, v in value.items()}
+    return value
+
